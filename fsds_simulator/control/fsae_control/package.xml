<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_control</name>
  <version>0.1.0</version>
  <description>Lateral/longitudinal control (Stanley) + FSDS command bridge for the simulator</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>fs_msgs</exec_depend>
  <exec_depend>fsae_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <!-- The MPC controller (mpc_core.py) additionally needs cvxpy, osqp and
       clarabel.  These are pip-only (no rosdep key), so install them once into
       the ROS interpreter rather than via rosdep:
         pip install cvxpy osqp clarabel
       (on Ubuntu 24.04 add the break-system-packages flag).  The Stanley
       controller (default) has no such dependency. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
