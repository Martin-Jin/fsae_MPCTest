__pycache__/
.claude/
CLAUDE.md
todo.md
/fsae_planning/

# tuner/speed_profile_export.csv and tuner/raceline_export.csv were
# ignored as regenerable artifacts until 2026-08-10. They are now
# tracked: sim.launch.py's path_map_path default points at
# raceline_export.csv, so it is a runtime dependency of the default
# launch config, not a throwaway output -- an ignored copy would
# leave a fresh clone pointing at a missing file. Regenerate with
#   python3 -m tuner.tools.raceline_optimizer      (raceline)
#   python3 -m tuner.tools.export_speed_profile    (centreline + speeds)

# fsds_simulator/recorded_runs/ (2026-08-11): tuner/tools/plot_playback.py's
# auto-search target for control-telemetry CSVs (see its --recorded-runs
# default and docs/developer_guide.md's "Plotting exported CSV telemetry").
# User-generated per-run data, same rationale as the outer FSDS repo's own
# fsae_logs/ .gitignore entry -- keep the folder (via .gitkeep) but not its
# contents.
/fsds_simulator/recorded_runs/*
!/fsds_simulator/recorded_runs/.gitkeep

# Track data (cone_map.json, speed_profile.csv, raceline.csv) moved
# 2026-08-10 to ros2/src/fsae_planning/tracks/ -- committed INSIDE the
# fsae_planning repo, so that repo + FSDS alone can drive a track with no
# fsae_MPCTest checkout. tracks/__init__.py's TRACKS_DIR points there; only
# that module's code still lives here, not the data. Regenerate/export a
# track with the commands above -- they now write across the repo boundary.
/tracks/*/
